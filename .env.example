# Connessione PostgreSQL
DATABASE_URL=postgres://omnia_marina:omnia_marina@localhost:5432/omnia_marina

# Consente a chiunque di registrare un nuovo porto da /registrazione (true/false)
ALLOW_SIGNUP=true

# Disattiva la telemetria anonima di Next.js
NEXT_TELEMETRY_DISABLED=1

# Applica le migrazioni del database all'avvio del server (già attivo nell'immagine Docker).
# In sviluppo si usa invece: pnpm db:migrate
AUTO_MIGRATE=false

# Solo per anteprime mostrate dentro un riquadro di un altro sito (iframe): permette di incorniciare
# l'app e rende il cookie di accesso utilizzabile lì. Abbassa le protezioni: mai in produzione.
EMBEDDED_PREVIEW=false
