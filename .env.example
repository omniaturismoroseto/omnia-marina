# Connessione PostgreSQL
DATABASE_URL=postgres://omnia_marina:omnia_marina@localhost:5432/omnia_marina

# Account manager di Omnia Marina: email (separate da virgole) di chi entra in tutti i porti come direzione,
# crea i porti con il loro direttore e nei porti non compare (utenti, registro, nomi accanto alle modifiche).
# L'account deve già esistere. /registrazione serve solo alla prima installazione, quando non c'è nessun porto.
# ACCOUNT_MANAGER_EMAILS=


# Disattiva la telemetria anonima di Next.js
NEXT_TELEMETRY_DISABLED=1

# Applica le migrazioni del database all'avvio del server (già attivo nell'immagine Docker).
# In sviluppo si usa invece: pnpm db:migrate
AUTO_MIGRATE=false

# Solo per anteprime mostrate dentro un riquadro di un altro sito (iframe): permette di incorniciare
# l'app e rende il cookie di accesso utilizzabile lì. Abbassa le protezioni: mai in produzione.
EMBEDDED_PREVIEW=false

# Accessi con Firebase Authentication (password custodite da Firebase, email di «password dimenticata»).
# Vuoto = password salvate nel database dell'app, come prima. Gli account passano su Firebase da soli al primo accesso.
# FIREBASE_PROJECT_ID=omnia-marina
# Chiave API web del progetto Firebase (non è un segreto: identifica il progetto).
# FIREBASE_API_KEY=
# Indirizzo pubblico dell'app: dopo aver scelto la nuova password, l'email riporta qui.
# APP_URL=https://omnia-marina-xxxxx.europe-west1.run.app
# Solo sviluppo e test: emulatore locale (npx firebase-tools emulators:start --only auth --project demo-omnia),
# con FIREBASE_PROJECT_ID=demo-omnia.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Notifiche sul telefono per i diportisti (web push). Vuote = notifiche spente (i messaggi restano nell'app).
# Chiavi da generare una volta con: npx web-push generate-vapid-keys
# La privata in produzione arriva dal segreto vapid-private-key, mai scritta qui.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contatto per i servizi push (predefinito: APP_URL), es. mailto:info@porto.it
# VAPID_SUBJECT=

# Allerta vento automatica: chiave che Cloud Scheduler manda a /api/meteo/controllo (almeno 20 caratteri).
# In produzione dal segreto meteo-check-token.
# METEO_CHECK_TOKEN=
# Previsioni Open-Meteo (vento e mare): spente senza chiave. L'uso gratuito è solo non commerciale: per accenderle
# serve l'abbonamento e la sua chiave.
# OPEN_METEO_API_KEY=
# Solo prove locali: file JSON { forecast, marine } con previsioni finte al posto di Open-Meteo.
# WEATHER_FIXTURE=
# Bollettino di criticità della Protezione Civile (letto da GitHub). Facoltativo: un token GitHub di sola lettura alza
# il limite di richieste all'API. Solo prove locali: DPC_FIXTURE = indice JSON del bollettino, con i TopoJSON in «topojson/» accanto.
# GITHUB_TOKEN=
# DPC_FIXTURE=
# Solo prove locali: indice del bollettino di vigilanza (files/AAAAMMGG.json), con i TopoJSON in «topojson/» accanto.
# DPC_VIGILANCE_FIXTURE=

# Riconoscimento automatico di pontili e banchine dalla foto (Claude). Vuoto = spento.
# Con la chiave Anthropic (ha la precedenza; in produzione arriva dal segreto anthropic-api-key, mai scritta qui):
# ANTHROPIC_API_KEY=
# Oppure con Claude su Vertex AI di Google (l'app si autentica con il proprio account di servizio):
# ANTHROPIC_VERTEX_PROJECT_ID=omnia-marina
# CLOUD_ML_REGION=global
